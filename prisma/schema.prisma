// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// CLIENTE — Empresa cliente (propietaria de la maquinaria)
// ============================================================
model Cliente {
  id               String       @id @default(cuid())
  nombre           String
  nif              String
  // Código de cliente en Business Central (Nº cliente en el Excel)
  codigoExterno    String?      @unique
  email            String?
  telefono         String?
  direccion        String?
  ciudad           String?
  codigoPostal     String?
  contactoNombre   String?
  contactoEmail    String?
  contactoTelefono String?
  estado           String       @default("ACTIVO") // ACTIVO | INACTIVO
  notas            String?
  // Zona geográfica interna (S1, S2, S3...) — filterable en la app
  zona             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  equipos          Equipo[]
  contratos        Contrato[]
}

// ============================================================
// EQUIPO — Maquinaria elevadora (grúas y montacargas)
// ============================================================
model Equipo {
  id                String   @id @default(cuid())
  codigo            String   @unique // código interno (ej. "005060" o "EQ-001")
  tipo              String   // GRUA_TORRE | GRUA_MOVIL | GRUA_PUENTE | MONTACARGAS_COMBUSTION | MONTACARGAS_ELECTRICO | DESCONOCIDO
  marca             String
  modelo            String
  numeroSerie       String   @unique
  anioFabricacion   Int?
  ubicacion         String?
  fechaInstalacion  DateTime?
  estado            String   @default("OPERATIVO") // OPERATIVO | EN_MANTENIMIENTO | FUERA_SERVICIO
  horasUso          Int      @default(0) // contador actual de horas (puede ser manual)
  horasSincronizadas Int?    // último valor de horas desde BC (para comparar al sincronizar)
  ultimaRevision    DateTime?
  notas             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clienteId         String
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Campos para cálculo de revisiones
  tipoRevision      String   @default("POR_HORAS") // POR_HORAS | POR_CONTRATO
  tipoRevisionManual Boolean @default(false) // true si el usuario lo cambió a mano (preservar en syncs)
  // Para equipos POR_HORAS: umbral actual aplicable (250 / 500 / 1000)
  umbralHorasActual  Int?     // ej. 250 para próxima pequeña, 500 para media, 1000 para gran
  // Próxima revisión (calculada al importar / actualizar horas)
  proximaRevisionHoras Int?   // ej. 3250 (umbral siguiente a horasUso)
  proximaRevisionFecha DateTime? // para POR_CONTRATO: fecha calendaria
  ultimoMantenimientoHoras Int? // horas del equipo en la última revisión
  codigoProductoBC  String?  @unique // Nº prod. servicio en Business Central
  contratoActivoId  String?  // CAI# actual (referencia texto libre)
  // Para equipos POR_CONTRATO (M1/M2/FSCR/FSSR): nº de revisiones contratadas al año (manual)
  // Si está a null, usa periodicidadMeses del contrato (default 12 meses)
  // Si está a N, calcula periodicidad = 12/N meses (ej: 4 → trimestral, 2 → semestral)
  revisionesContratadasAnual Int?
  esHistorico      Boolean  @default(false) // true si ya no aparece en BC (contrato caducado/equipo retirado)

  contratos         ContratoEquipo[]
  ordenesTrabajo    OrdenTrabajo[]
  revisiones        RevisionProgramada[]
}

// ============================================================
// REVISION PROGRAMADA — Calendario de revisiones calculadas
// ============================================================
model RevisionProgramada {
  id                String   @id @default(cuid())
  equipoId          String
  equipo            Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  tipo              String   // POR_HORAS | POR_CONTRATO
  nivel             String?  // PEQUENA (250h) | MEDIA (500h) | GRANDE (1000h) | CONTRATO
  horasObjetivo     Int?     // para POR_HORAS: umbral de horas (ej. 3250)
  fechaProgramada   DateTime // fecha calculada en la que debería hacerse
  fechaEstimadaCumplimiento DateTime? // estimación de cuándo se alcanzarán las horas
  estado            String   @default("PROGRAMADA") // PROGRAMADA | COMPLETADA | VENCIDA
  fechaRealizada    DateTime?
  ordenTrabajoId    String?  // si se generó OT automática
  notas             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================================
// CONTRATO — Contrato de mantenimiento
// ============================================================
model Contrato {
  id                    String   @id @default(cuid())
  numero                String   @unique // Nº Contrato BC
  clienteId             String
  cliente               Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  fechaInicio           DateTime
  fechaFin              DateTime
  tipoMantenimiento     String   @default("PREVENTIVO") // PREVENTIVO | CORRECTIVO | MIXTO
  periodicidadMeses     Int      @default(3)
  precioAnual           Float
  precioVisita          Float?
  estado                String   @default("ACTIVO") // ACTIVO | VENCIDO | SUSPENDIDO | CANCELADO
  fechaProxMantenimiento DateTime?
  condiciones           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Campos adicionales sincronizados desde Business Central
  descripcionBC         String?  // Descripción del Excel
  codVendedor           String?  // Cód. vendedor
  codDelegacion         String?  // Código Delegacion
  codGrupoContrato      String?  // Cód. grupo contrato
  codPeriodoPrecio      String?  // Periodo actualiz. precio (e.g. "1Y")
  ubicacionEquipo       String?  // Cód. dirección envío cliente
  ultimaFactura         DateTime? // Últ. fecha factura
  proximaFactura        DateTime? // Siguiente fecha factura
  importePorPeriodo     Float?  // Importe por periodo original (para no perderlo)
  esHistorico           Boolean @default(false) // true si ya no aparece en BC (caducado/cancelado)

  equipos               ContratoEquipo[]
  ordenesTrabajo        OrdenTrabajo[]
}

// Tabla intermedia relación N:M Contrato <-> Equipo
model ContratoEquipo {
  id          String   @id @default(cuid())
  contratoId  String
  equipoId    String
  contrato    Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  equipo      Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, equipoId])
}

// ============================================================
// TECNICO — Personal de mantenimiento
// ============================================================
model Tecnico {
  id          String   @id @default(cuid())
  nombre      String
  apellidos   String
  dni         String?
  especialidad String? // MECANICA | ELECTRONICA | HIDRAULICA | GENERAL
  email       String?
  telefono    String?
  estado      String   @default("ACTIVO") // ACTIVO | INACTIVO | VACACIONES
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ordenesTrabajo OrdenTrabajo[]
}

// ============================================================
// ORDEN DE TRABAJO — Mantenimiento preventivo/correctivo
// ============================================================
model OrdenTrabajo {
  id              String    @id @default(cuid())
  numero          String    @unique // OT-2026-001
  equipoId        String
  equipo          Equipo    @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  contratoId      String?
  contrato        Contrato? @relation(fields: [contratoId], references: [id], onDelete: SetNull)

  tecnicoId       String?
  tecnico         Tecnico?  @relation(fields: [tecnicoId], references: [id], onDelete: SetNull)

  tipo            String    @default("PREVENTIVO") // PREVENTIVO | CORRECTIVO | REPARACION
  estado          String    @default("PROGRAMADA") // PROGRAMADA | EN_PROCESO | COMPLETADA | CANCELADA
  prioridad       String    @default("MEDIA") // BAJA | MEDIA | ALTA | URGENTE
  descripcion     String
  observaciones   String?
  fechaProgramada DateTime
  fechaRealizada  DateTime?
  horasTrabajadas Float?
  importe         Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================
// SYNC LOG — Historial de sincronizaciones con Business Central
// ============================================================
model SyncLog {
  id              String   @id @default(cuid())
  fecha           DateTime @default(now())
  fileName        String
  fileSize        Int
  rowsTotal       Int      @default(0)
  rowsCreated     Int      @default(0)
  rowsUpdated     Int      @default(0)
  rowsSkipped     Int      @default(0)
  rowsFailed      Int      @default(0)
  clientesNuevos  Int      @default(0)
  contratosNuevos Int      @default(0)
  contratosActualizados Int @default(0)
  duracionMs      Int      @default(0)
  status          String   @default("OK") // OK | PARCIAL | ERROR
  errores         String?  // JSON string con lista de errores (truncado)
  syncType        String   @default("EXCEL_BC") // EXCEL_BC | API_BC | MANUAL
}
