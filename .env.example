# ============================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN
# Copia este archivo a .env y rellena con tus valores reales.
# En Vercel, configura estas variables en Project Settings → Environment Variables.
# ============================================================

# --- BASE DE DATOS (Neon PostgreSQL) ---
# Obtén esta URL desde tu panel de Neon: https://neon.tech
# Formato: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# URL directa (sin pooler) para migraciones
# En Neon, en la pestaña "Connection Details" → activa "Direct connection"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- OPCIONAL: CONFIGURACIÓN LOCAL CON SQLITE ---
# Si quieres desarrollar en local con SQLite (sin PostgreSQL):
# 1. Cambia el provider en prisma/schema.prisma de "postgresql" a "sqlite"
# 2. Comenta o borra la línea de directUrl
# 3. Usa: DATABASE_URL="file:./dev.db"
